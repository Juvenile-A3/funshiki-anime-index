# Only website files are versioned. Everything else stays local.
/*
!/.github/
/.github/*
!/config/
/config/*
!/data/
/data/*
!/scripts/
/scripts/*
!/site/
/site/*
!/tests/
/tests/*
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/workflows/
/.github/workflows/*
!/site/assets/
/site/assets/*
!/site/assets/covers/
/site/assets/covers/*
!/site/assets/credits/
/site/assets/credits/*
!/.gitattributes
!/.github/ISSUE_TEMPLATE/correction.yml
!/.github/workflows/pages.yml
!/.gitignore
!/CNAME
!/README.md
!/config/about.json
!/config/season-policy.json
!/config/site.json
!/config/subject-overrides.json
!/data/catalog.json
!/package.json
!/scripts/build.mjs
!/scripts/public-catalog.mjs
!/scripts/requirements-assets.txt
!/scripts/serve.mjs
!/scripts/sync_site_assets.py
!/scripts/sync_site_seasons.py
!/site/about.mjs
!/site/analytics.mjs
!/site/app.mjs
!/site/assets.mjs
!/site/assets/credits/fanshi.webp
!/site/assets/credits/recorders.webp
!/site/assets/logo.png
!/site/assets/subjects.json
!/site/domain.mjs
!/site/index.html
!/site/style.css
!/tests/analytics.test.mjs
!/tests/archive.test.mjs
!/tests/assets.test.mjs
!/tests/domain.test.mjs
!/tests/public-catalog.test.mjs
!/tests/test_site_assets.py
!/tests/test_site_seasons.py
!/site/assets/covers/*.webp
